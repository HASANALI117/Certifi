@inject INavLinks NavLinks
@{
    var userName = User.Identity?.Name ?? string.Empty;
    var initial = !string.IsNullOrWhiteSpace(userName) ? userName.Substring(0, 1).ToUpperInvariant() : "U";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string NavActive(string ctrl, string? action = null)
    {
        if (!string.Equals(ctrl, currentController, StringComparison.OrdinalIgnoreCase)) return "";
        if (action is null) return "active";
        return string.Equals(action, currentAction, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}
<aside class="dash-sidebar">
    <a class="dash-brand" href="@NavLinks.Mvc("/Dashboard")">
        <span class="dash-brand-mark">
            <img src="~/images/logo-3.png" alt="Certifi" class="dash-brand-logo" />
        </span>
        <span class="dash-brand-text">Certifi</span>
    </a>

    <nav class="dash-nav">
        <div class="dash-nav-section dash-nav-section--readonly">
            <span>Manage</span>
        </div>
        <a class="dash-nav-item dash-nav-item--external" href="@NavLinks.Mvc("/Dashboard")">
            <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
        </a>
        <a class="dash-nav-item dash-nav-item--external" href="@NavLinks.Mvc("/Courses")">
            <i class="bi bi-collection"></i><span>Courses</span>
        </a>
        <a class="dash-nav-item dash-nav-item--external" href="@NavLinks.Mvc("/CourseSessions")">
            <i class="bi bi-calendar-event"></i><span>Sessions</span>
        </a>
        <a class="dash-nav-item dash-nav-item--external" href="@NavLinks.Mvc("/Certification/Lookup")">
            <i class="bi bi-patch-check"></i><span>Certifications</span>
        </a>
        <a class="dash-nav-item dash-nav-item--external" href="@NavLinks.Mvc("/Enrollments/Manage")">
            <i class="bi bi-people-fill"></i><span>Enrollments</span>
        </a>
        <a class="dash-nav-item dash-nav-item--external" href="@NavLinks.Mvc("/Categories")">
            <i class="bi bi-tags"></i><span>Categories</span>
        </a>
        <a class="dash-nav-item dash-nav-item--external" href="@NavLinks.Mvc("/Classrooms")">
            <i class="bi bi-building"></i><span>Classrooms</span>
        </a>
        <a class="dash-nav-item dash-nav-item--external" href="@NavLinks.Mvc("/Instructors")">
            <i class="bi bi-person-video3"></i><span>Instructors</span>
        </a>
        <a class="dash-nav-item dash-nav-item--external" href="@NavLinks.Mvc("/Trainees")">
            <i class="bi bi-person"></i><span>Trainees</span>
        </a>

        <div class="dash-nav-section dash-nav-section--readonly">
            <span>Reports</span>
            <span class="dash-readonly-badge">Read-only</span>
        </div>
        <a class="dash-nav-item @NavActive("Dashboard")" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-bar-chart-line"></i><span>Overview</span>
        </a>
        <a class="dash-nav-item @NavActive("Reports", "Enrollments")" asp-controller="Reports" asp-action="Enrollments">
            <i class="bi bi-clipboard-data"></i><span>Enrollments</span>
        </a>
        <a class="dash-nav-item @NavActive("Reports", "Instructors")" asp-controller="Reports" asp-action="Instructors">
            <i class="bi bi-easel"></i><span>Instructors</span>
        </a>
        <a class="dash-nav-item @NavActive("Reports", "Sessions")" asp-controller="Reports" asp-action="Sessions">
            <i class="bi bi-calendar-week"></i><span>Sessions</span>
        </a>
        <a class="dash-nav-item @NavActive("Reports", "Certifications")" asp-controller="Reports" asp-action="Certifications">
            <i class="bi bi-award"></i><span>Certifications</span>
        </a>
        <a class="dash-nav-item @NavActive("Reports", "Revenue")" asp-controller="Reports" asp-action="Revenue">
            <i class="bi bi-cash-coin"></i><span>Revenue</span>
        </a>
        <a class="dash-nav-item @NavActive("Reports", "Trainees")" asp-controller="Reports" asp-action="Trainees">
            <i class="bi bi-people"></i><span>Trainees</span>
        </a>
    </nav>

    <div class="dash-sidebar-footer">
        <div class="dropdown dropup w-100 tp-user-wrap">
            <button class="dash-user-btn position-relative" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                <span class="dash-user-avatar" aria-hidden="true">@initial</span>
                <span class="dash-user-meta">
                    <span class="dash-user-name">@userName</span>
                    <span class="dash-user-role">Coordinator</span>
                </span>
                <i class="bi bi-chevron-up dash-user-caret"></i>
            </button>
            <div class="dropdown-menu p-0 tp-user-menu">
                <div class="px-3 py-2 border-bottom tp-user-menu-head">
                    <div class="small text-muted">Signed in as</div>
                    <div class="fw-semibold text-truncate">@userName</div>
                </div>
                <a class="dropdown-item py-2 px-3" href="@NavLinks.Mvc("/Dashboard")">
                    <i class="bi bi-arrow-left me-2"></i>Back to management
                </a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 border-top">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item tp-user-logout text-danger py-2 px-3">
                        <i class="bi bi-box-arrow-left me-2"></i>Log out
                    </button>
                </form>
            </div>
        </div>
    </div>
</aside>
