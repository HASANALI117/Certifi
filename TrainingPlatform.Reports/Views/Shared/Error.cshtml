@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_AuthLayout";
}

<div class="card shadow-sm">
    <div class="card-body p-4 text-center">
        <h1 class="h4 text-danger">Something went wrong</h1>
        <p class="text-muted">An unexpected error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-3">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Back to dashboard</a>
    </div>
</div>
