@model List<SessionReportRow>
@{
    ViewData["Title"] = "Sessions";
    var ordered = Model.OrderBy(s => s.StartDateTime).ToList();
    int totalCapacity = ordered.Sum(s => s.Capacity);
    int totalEnrolled = ordered.Sum(s => s.EnrolledCount);
    double avgFill = totalCapacity == 0 ? 0 : (double)totalEnrolled * 100 / totalCapacity;
}

<div class="page-header d-flex justify-content-between align-items-end">
    <div>
        <h1 class="h3 mb-0">Sessions</h1>
        <div class="text-muted small">All scheduled sessions with fill-rate visual (@Model.Count sessions)</div>
    </div>
    <div class="text-end">
        <div class="text-muted small">Overall fill rate</div>
        <div class="h5 mb-0">@avgFill.ToString("N1")%</div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <strong>Sessions</strong>
        <span class="badge text-bg-secondary">@Model.Count</span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover table-report mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>When</th>
                    <th>Course</th>
                    <th>Category</th>
                    <th>Instructor</th>
                    <th>Classroom</th>
                    <th style="min-width:160px;">Fill rate</th>
                    <th class="text-end">Enrolled / Cap</th>
                    <th class="text-end">Attending</th>
                    <th class="text-end">Completed</th>
                    <th class="text-end">Dropped</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="10" class="text-center text-muted py-3">No session data available.</td></tr>
                }
                @foreach (var s in ordered)
                {
                    var fill = s.Capacity == 0 ? 0 : (double)s.EnrolledCount * 100 / s.Capacity;
                    var fillClass = fill >= 90 ? "bg-danger" : fill >= 70 ? "bg-warning" : "bg-success";
                    <tr>
                        <td>
                            <div>@s.StartDateTime.ToLocalTime().ToString("MMM d, yyyy")</div>
                            <div class="small text-muted">@s.StartDateTime.ToLocalTime().ToString("h:mm tt")</div>
                        </td>
                        <td>@s.CourseTitle</td>
                        <td><span class="badge text-bg-light border">@s.CategoryName</span></td>
                        <td>@s.InstructorName</td>
                        <td>@s.ClassroomName</td>
                        <td>
                            <div class="progress" style="height:14px;" role="progressbar" aria-valuenow="@fill.ToString("F0")" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar @fillClass" style="width:@fill.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%;">
                                    @fill.ToString("F0")%
                                </div>
                            </div>
                        </td>
                        <td class="text-end">@s.EnrolledCount / @s.Capacity</td>
                        <td class="text-end">@s.AttendingCount</td>
                        <td class="text-end text-success">@s.CompletedCount</td>
                        <td class="text-end text-danger">@s.DroppedCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
