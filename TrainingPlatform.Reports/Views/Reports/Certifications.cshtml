@model List<CertificationReportRow>
@{
    ViewData["Title"] = "Certifications";
    var ordered = Model.OrderByDescending(c => c.CompletionRate).ToList();
}

<div class="page-header">
    <h1 class="h3 mb-0">Certifications</h1>
    <div class="text-muted small">Completion progress by certification track (@Model.Count tracks)</div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <strong>Tracks</strong>
        <span class="badge text-bg-secondary">@Model.Count</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-report mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Track</th>
                    <th class="text-end">Trainees</th>
                    <th class="text-end">In Progress</th>
                    <th class="text-end">Eligible</th>
                    <th class="text-end">Issued</th>
                    <th style="min-width:220px;">Completion Rate</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">No certification data available.</td></tr>
                }
                @foreach (var c in ordered)
                {
                    var rate = (double)c.CompletionRate;
                    var cls = rate >= 75 ? "bg-success" : rate >= 40 ? "bg-info" : rate >= 15 ? "bg-warning" : "bg-danger";
                    <tr>
                        <td><strong>@c.TrackName</strong></td>
                        <td class="text-end">@c.TotalTrainees.ToString("N0")</td>
                        <td class="text-end">@c.InProgressCount.ToString("N0")</td>
                        <td class="text-end">@c.EligibleCount.ToString("N0")</td>
                        <td class="text-end text-success fw-semibold">@c.IssuedCount.ToString("N0")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height:16px;" role="progressbar"
                                     aria-valuenow="@rate.ToString("F1")" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar @cls" style="width:@rate.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;">
                                        @rate.ToString("F1")%
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
