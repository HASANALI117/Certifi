@model DashboardViewModel
@{
    ViewData["Title"] = "Reports Overview";
    var o = Model.Overview;
}

<header class="dash-page-head">
    <div class="dash-page-head-row">
        <div>
            <h1 class="dash-page-h">Reports Overview</h1>
            <p class="dash-page-lede">Operational snapshot across courses, sessions, enrollments and revenue.</p>
        </div>
        <div class="text-color-soft small">@DateTime.Now.ToString("dddd, MMM d, yyyy")</div>
    </div>
</header>

<section class="dash-chip-row" aria-label="At a glance">
    <div class="dash-summary">
        <span class="dash-summary-icon"><i class="bi bi-collection"></i></span>
        <div>
            <div class="dash-summary-val">@o.TotalCourses.ToString("N0")</div>
            <div class="dash-summary-lbl">Total courses</div>
        </div>
    </div>
    <div class="dash-summary">
        <span class="dash-summary-icon is-info"><i class="bi bi-calendar-event"></i></span>
        <div>
            <div class="dash-summary-val">@o.TotalSessions.ToString("N0")</div>
            <div class="dash-summary-lbl">Total sessions</div>
        </div>
    </div>
    <div class="dash-summary">
        <span class="dash-summary-icon"><i class="bi bi-people"></i></span>
        <div>
            <div class="dash-summary-val">@o.TotalTrainees.ToString("N0")</div>
            <div class="dash-summary-lbl">Trainees</div>
        </div>
    </div>
    <div class="dash-summary">
        <span class="dash-summary-icon is-warn"><i class="bi bi-easel"></i></span>
        <div>
            <div class="dash-summary-val">@o.TotalInstructors.ToString("N0")</div>
            <div class="dash-summary-lbl">Instructors</div>
        </div>
    </div>
    <div class="dash-summary">
        <span class="dash-summary-icon is-info"><i class="bi bi-clipboard-data"></i></span>
        <div>
            <div class="dash-summary-val">@o.ActiveEnrollments.ToString("N0")</div>
            <div class="dash-summary-lbl">Active enrollments</div>
        </div>
    </div>
    <div class="dash-summary">
        <span class="dash-summary-icon"><i class="bi bi-check2-circle"></i></span>
        <div>
            <div class="dash-summary-val">@o.CompletedEnrollments.ToString("N0")</div>
            <div class="dash-summary-lbl">Completed enrollments</div>
        </div>
    </div>
    <div class="dash-summary">
        <span class="dash-summary-icon is-pink"><i class="bi bi-patch-check-fill"></i></span>
        <div>
            <div class="dash-summary-val">@o.CertificatesIssued.ToString("N0")</div>
            <div class="dash-summary-lbl">Certificates issued</div>
        </div>
    </div>
    <div class="dash-summary">
        <span class="dash-summary-icon is-danger"><i class="bi bi-cash-coin"></i></span>
        <div>
            <div class="dash-summary-val">@o.TotalRevenue.ToString("C0")</div>
            <div class="dash-summary-lbl">Revenue · @o.OutstandingRevenue.ToString("C0") outstanding</div>
        </div>
    </div>
</section>

<section class="dash-panel" aria-labelledby="recent-enrolls-title">
    <div class="dash-panel-head">
        <div>
            <h2 class="dash-panel-title" id="recent-enrolls-title">Recent enrollments</h2>
            <div class="dash-panel-sub">@Model.RecentEnrollments.Count latest</div>
        </div>
    </div>
    <div class="table-responsive">
        <table class="dash-data-table">
            <thead>
                <tr>
                    <th>Trainee</th>
                    <th>Course</th>
                    <th>Session</th>
                    <th>Status</th>
                    <th class="text-end">Enrolled</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentEnrollments.Any())
                {
                    <tr><td colspan="5" class="dash-td-empty">No recent enrollments.</td></tr>
                }
                @foreach (var r in Model.RecentEnrollments)
                {
                    <tr>
                        <td data-label="Trainee">@r.TraineeName</td>
                        <td data-label="Course">@r.CourseTitle</td>
                        <td data-label="Session">@(r.SessionDate?.ToString("MMM d, yyyy") ?? "—")</td>
                        <td data-label="Status"><span class="dash-pill dash-pill-info">@r.Status</span></td>
                        <td data-label="Enrolled" class="text-end">@r.EnrolledAt.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="dash-panel" aria-labelledby="upcoming-sessions-title">
    <div class="dash-panel-head">
        <div>
            <h2 class="dash-panel-title" id="upcoming-sessions-title">Upcoming sessions</h2>
            <div class="dash-panel-sub">@Model.UpcomingSessions.Count scheduled</div>
        </div>
    </div>
    <div class="table-responsive">
        <table class="dash-data-table">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Instructor</th>
                    <th>Classroom</th>
                    <th>When</th>
                    <th class="text-end">Spots</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.UpcomingSessions.Any())
                {
                    <tr><td colspan="5" class="dash-td-empty">No upcoming sessions.</td></tr>
                }
                @foreach (var s in Model.UpcomingSessions)
                {
                    var fill = s.Capacity == 0 ? 0 : (s.Capacity - s.SpotsRemaining) * 100 / s.Capacity;
                    <tr>
                        <td data-label="Course">@s.CourseTitle</td>
                        <td data-label="Instructor">@s.InstructorName</td>
                        <td data-label="Classroom">@s.ClassroomName</td>
                        <td data-label="When">@s.StartDateTime.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                        <td data-label="Spots" class="text-end">
                            <span class="@(s.SpotsRemaining == 0 ? "text-danger" : "text-success") fw-semibold">@s.SpotsRemaining</span>
                            <div class="small text-color-soft">@fill% full</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
