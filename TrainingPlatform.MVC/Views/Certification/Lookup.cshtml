@model TrainingPlatform.MVC.Models.ViewModels.CertificationLookupViewModel
@{
    ViewData["Title"] = "Verify Certificate";
    // Verify is a public, home-page feature styled as a landing auth card. Force
    // the landing layout (which loads landing.css) so it renders correctly even
    // if an authenticated user reaches the URL — _ViewStart would otherwise pick
    // _DashboardLayout for them and leave the tp-auth-* card unstyled.
    Layout = "_Layout";
}

@* Public page for checking a certificate. Looks like the login page. *@
<div class="tp-auth-shell tp-auth-shell--stack">
    <div class="tp-auth-card">
        <a asp-controller="Home" asp-action="Index" class="tp-auth-logo-link" aria-label="Certifi — back to home">
            <img src="~/images/logo-3.png" alt="Certifi" class="tp-auth-logo" />
        </a>
        <h1 class="tp-auth-title">Verify a Certificate</h1>
        <p class="tp-auth-sub">No login required. Enter a Trainee ID and a Certificate Reference Number to check status.</p>

        <form asp-action="Lookup" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-circle"></i><div class="flex-grow-1"></div>
            </div>

            <div class="mb-3">
                <label asp-for="TraineeId" class="form-label"></label>
                <input asp-for="TraineeId" class="form-control" placeholder="e.g. user-guid-here" />
                <span asp-validation-for="TraineeId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CertRef" class="form-label"></label>
                <input asp-for="CertRef" class="form-control tp-mono" placeholder="e.g. CERT-2025-00142" />
                <span asp-validation-for="CertRef" class="text-danger"></span>
            </div>

            <button type="submit" class="button special">Verify Certificate</button>
        </form>

        <p class="tp-auth-footer">
            Have an account? <a asp-controller="Account" asp-action="Login">Sign in</a>
        </p>
    </div>

    <div class="tp-auth-result">
        <partial name="_LookupResult" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
