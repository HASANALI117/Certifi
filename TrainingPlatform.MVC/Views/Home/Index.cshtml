@{
    ViewData["Title"] = "Home";
    ViewData["FullWidth"] = true;
}

<div class="cd-inner">

    <section class="intro-wrapper">
        <div class="tp-hero-fx" aria-hidden="true">
            <div class="tp-orb o1"></div>
            <div class="tp-orb o2"></div>
            <div class="tp-orb o3"></div>
        </div>
        <div class="content">
            <img src="~/images/logo-2.png" alt="Certifi" class="cd-logo" />
            <h1><span class="tp-split" data-splittext>Certifi</span></h1>
            <p>Modern training operations &mdash; catalog, scheduling, and certificates.</p>
            <ul class="action-list stacked">
                <li><a asp-controller="Courses" asp-action="Index" class="button special wide">Browse Courses</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                            <button type="submit" class="button wide">Log Out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="Login" class="button wide">Log In</a></li>
                }
            </ul>
        </div>
        <a href="#about">What's inside?</a>
    </section>

    <section id="about" class="about-wrapper style1">
        <header>
            <h2>Run training for<br/>pretty much any program</h2>
            <p>Catalog, sessions, instructors, certifications &mdash; coordinated end to end.<br/>Built for trainees, instructors, and coordinators.</p>
        </header>
        <div class="carousel">
            <div class="reel">
                @for (int i = 0; i < 2; i++)
                {
                    <a asp-controller="Courses" asp-action="Index">
                        <div class="card-inner">
                            <i class="bi bi-collection"></i>
                            <h3>Course Catalog</h3>
                            <p>Curated courses with prerequisites, fees, and capacity.</p>
                        </div>
                    </a>
                    <a asp-controller="CourseSessions" asp-action="Index">
                        <div class="card-inner">
                            <i class="bi bi-calendar-event"></i>
                            <h3>Scheduling</h3>
                            <p>Sessions with automatic conflict checks for rooms and instructors.</p>
                        </div>
                    </a>
                    <a asp-controller="Instructors" asp-action="Index">
                        <div class="card-inner">
                            <i class="bi bi-person-badge"></i>
                            <h3>Instructors</h3>
                            <p>Expertise areas, bios, and session loads at a glance.</p>
                        </div>
                    </a>
                    <a asp-controller="Classrooms" asp-action="Index">
                        <div class="card-inner">
                            <i class="bi bi-door-open"></i>
                            <h3>Classrooms</h3>
                            <p>Capacity and equipment per room, never double-booked.</p>
                        </div>
                    </a>
                    <a asp-controller="Certification" asp-action="Lookup">
                        <div class="card-inner">
                            <i class="bi bi-patch-check"></i>
                            <h3>Certificate Lookup</h3>
                            <p>Public verification &mdash; no login required, confirm in seconds.</p>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>

    <section class="highlights-wrapper">
        <section>
            <div class="pic"><div class="highlight tp-tilt-card"><span class="tp-tilt-shine"></span><i class="bi bi-mortarboard"></i></div></div>
            <div class="content">
                <h2><span class="tp-split" data-splittext>Trainees</span></h2>
                <p>Enroll in sessions, track certification progress, and view payments and outstanding balances &mdash; everything you need to plan your learning path.</p>
            </div>
        </section>
        <section>
            <div class="pic"><div class="highlight tp-tilt-card"><span class="tp-tilt-shine"></span><i class="bi bi-easel"></i></div></div>
            <div class="content">
                <h2><span class="tp-split" data-splittext>Instructors</span></h2>
                <p>See assigned sessions, attendance, and record pass/fail assessment results per trainee. Every credential, every track, every classroom.</p>
            </div>
        </section>
        <section>
            <div class="pic"><div class="highlight tp-tilt-card"><span class="tp-tilt-shine"></span><i class="bi bi-sliders"></i></div></div>
            <div class="content">
                <h2><span class="tp-split" data-splittext>Coordinators</span></h2>
                <p>Full control &mdash; users, courses, schedules, certifications, payments, and operational reporting in one workspace.</p>
            </div>
        </section>
    </section>

    <section class="pro-wrapper style1">
        <header>
            <h2><span class="tp-split tp-sweep" data-splittext>Everything you need</span></h2>
            <p>Core features ready out of the box &mdash; from prerequisite validation<br/>to real-time enrollment counters and certification tracks.</p>
        </header>
        <div class="content">
            <ul class="pro-features">
                <li>
                    <h3>Prerequisite Validation</h3>
                    <p>Enrollment checks confirm the trainee has completed required prior courses before confirming a seat.</p>
                </li>
                <li>
                    <h3>Capacity Limits</h3>
                    <p>Sessions auto-reject enrollment when the classroom is full &mdash; with a live counter powered by SignalR.</p>
                </li>
                <li>
                    <h3>No Double-Booking</h3>
                    <p>Instructor and classroom conflicts are detected and blocked before a session is saved.</p>
                </li>
                <li>
                    <h3>Certification Tracks</h3>
                    <p>Auto-mark trainees Eligible the moment every course in a track is passed &mdash; no manual checks.</p>
                </li>
                <li>
                    <h3>Payment Tracking</h3>
                    <p>Outstanding balance per enrollment with automatic overdue flagging based on due dates.</p>
                </li>
                <li>
                    <h3>Operational Reports</h3>
                    <p>Enrollment, instructor workload, completion rates, and revenue dashboards for coordinators.</p>
                </li>
            </ul>
            <div class="pro-cta">
                <p><strong>Ready to start?</strong> Pick a path below &mdash; no signup needed to verify a certificate.</p>
                <ul class="action-list stacked">
                    <li><a asp-controller="Certification" asp-action="Lookup" class="button special wide">Certification Lookup</a></li>
                </ul>
            </div>
        </div>
    </section>

    <section class="cta-wrapper style2">
        <h2><span class="tp-split" data-splittext>Sound good?</span></h2>
        <p>Click below to get started.</p>
        <ul class="action-list stacked">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li><a asp-controller="Courses" asp-action="Index" class="button special wide">Browse Courses</a></li>
            }
            else
            {
                <li><a asp-controller="Account" asp-action="Register" class="button special wide">Get Started</a></li>
                <li><a asp-controller="Account" asp-action="Login" class="button wide">Log In</a></li>
            }
        </ul>
    </section>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script>
        (function () {
            var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            // --- Letter-split for headings (word-grouped) ---
            document.querySelectorAll('[data-splittext]').forEach(function (el) {
                var text = el.textContent;
                el.textContent = '';
                var tokens = text.split(/(\s+)/);
                var i = 0;
                tokens.forEach(function (token) {
                    if (token === '') return;
                    if (/^\s+$/.test(token)) {
                        el.appendChild(document.createTextNode(token));
                        return;
                    }
                    var word = document.createElement('span');
                    word.className = 'tp-word';
                    Array.prototype.forEach.call(token, function (ch) {
                        var span = document.createElement('span');
                        span.className = 'tp-char';
                        span.style.transitionDelay = (i * 28) + 'ms';
                        span.textContent = ch;
                        word.appendChild(span);
                        i++;
                    });
                    el.appendChild(word);
                });
            });

            // --- 3D tilt cards (pointer-driven rotateX/rotateY + shine) ---
            (function tiltCards() {
                if (reduce) return;
                document.querySelectorAll('.tp-tilt-card').forEach(function (card) {
                    var rect;
                    function onEnter() {
                        rect = card.getBoundingClientRect();
                        card.classList.add('is-tilting');
                    }
                    function onMove(e) {
                        if (!rect) rect = card.getBoundingClientRect();
                        var px = (e.clientX - rect.left) / rect.width;
                        var py = (e.clientY - rect.top) / rect.height;
                        var rx = (0.5 - py) * 14; // tilt up/down
                        var ry = (px - 0.5) * 18; // tilt left/right
                        card.style.transform =
                            'perspective(800px) rotateX(' + rx.toFixed(2) + 'deg) rotateY(' + ry.toFixed(2) + 'deg) translateZ(6px)';
                        card.style.setProperty('--sx', (px * 100).toFixed(1) + '%');
                        card.style.setProperty('--sy', (py * 100).toFixed(1) + '%');
                    }
                    function onLeave() {
                        card.classList.remove('is-tilting');
                        card.style.transform = '';
                        rect = null;
                    }
                    card.addEventListener('pointerenter', onEnter);
                    card.addEventListener('pointermove', onMove);
                    card.addEventListener('pointerleave', onLeave);
                });
            })();

            // --- Sweep underline + letter reveal on scroll into view ---
            (function reveal() {
                if (!('IntersectionObserver' in window)) {
                    document.querySelectorAll('.tp-split .tp-char').forEach(function (c) { c.style.opacity = 1; });
                    document.querySelectorAll('.tp-sweep').forEach(function (el) { el.classList.add('is-in'); });
                    return;
                }
                // Prime letters as hidden so the IntersectionObserver can play them in
                document.querySelectorAll('.tp-split .tp-char').forEach(function (c) {
                    c.style.opacity = 0;
                    c.style.transform = 'translateY(0.4em) rotate(2deg)';
                    c.style.transition = 'opacity .55s ease, transform .65s cubic-bezier(.2,.7,.3,1)';
                });
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (!entry.isIntersecting) return;
                        var t = entry.target;
                        if (t.classList.contains('tp-split')) {
                            t.querySelectorAll('.tp-char').forEach(function (c) {
                                c.style.opacity = 1;
                                c.style.transform = 'translateY(0) rotate(0)';
                            });
                        }
                        if (t.classList.contains('tp-sweep')) {
                            t.classList.add('is-in');
                        }
                        io.unobserve(t);
                    });
                }, { threshold: 0.2, rootMargin: '0px 0px -10% 0px' });
                document.querySelectorAll('.tp-split, .tp-sweep').forEach(function (el) { io.observe(el); });
            })();

            // --- GSAP scroll-driven enhancements (only if GSAP is on the page) ---
            if (typeof gsap === 'undefined' || reduce) return;
            gsap.registerPlugin(ScrollTrigger);

            // Onload hero entrance — keep logo + paragraph + actions choreography
            var heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });
            heroTl
                .from('.intro-wrapper .content > svg, .intro-wrapper .content > .cd-logo', { y: -20, opacity: 0, scale: .85, duration: 1 })
                .from('.intro-wrapper .content p',     { y: 20, opacity: 0, duration: .7 }, '-=.55')
                .from('.intro-wrapper .action-list li',{ y: 18, opacity: 0, stagger: .12, duration: .55 }, '-=.45')
                .from('.intro-wrapper a[href="#about"]',{ y: 14, opacity: 0, duration: .55 }, '-=.25');

            // Subtle logo float
            gsap.to('.intro-wrapper .content > svg, .intro-wrapper .content > .cd-logo', {
                y: -8, duration: 2.6, ease: 'sine.inOut', yoyo: true, repeat: -1
            });

            // Hero orbs subtle parallax with scroll
            gsap.utils.toArray('.tp-orb').forEach(function (orb, i) {
                var depth = (i + 1) * 40;
                gsap.to(orb, {
                    y: depth,
                    ease: 'none',
                    scrollTrigger: { trigger: '.intro-wrapper', start: 'top top', end: 'bottom top', scrub: true }
                });
            });

            // Each section rises + fades on enter (skip intro-wrapper and marquee)
            gsap.utils.toArray('.cd-inner > section:not(.intro-wrapper)').forEach(function (sec) {
                gsap.from(sec, {
                    y: 50, opacity: 0, duration: 1, ease: 'power3.out',
                    scrollTrigger: { trigger: sec, start: 'top 85%', once: true }
                });
            });

            // Highlights pinned with horizontal slide per row
            gsap.utils.toArray('.highlights-wrapper > section').forEach(function (row, i) {
                var fromX = (i % 2 === 0) ? -80 : 80;
                gsap.from(row, {
                    x: fromX, opacity: 0, duration: 1.1, ease: 'power3.out',
                    scrollTrigger: { trigger: row, start: 'top 82%', once: true }
                });
                // Parallax the icon as the row scrolls
                var icon = row.querySelector('.highlight i');
                if (icon) {
                    gsap.to(icon, {
                        y: -30, rotate: i % 2 === 0 ? -8 : 8,
                        ease: 'none',
                        scrollTrigger: { trigger: row, start: 'top bottom', end: 'bottom top', scrub: true }
                    });
                }
            });

            // Carousel cards scrub a tiny X drift while parent scrolls (depth feel)
            var reel = document.querySelector('.about-wrapper .reel');
            if (reel) {
                gsap.to(reel, {
                    x: -60,
                    ease: 'none',
                    scrollTrigger: {
                        trigger: '.about-wrapper',
                        start: 'top 80%',
                        end: 'bottom top',
                        scrub: 1
                    }
                });
            }

            // Pro feature bullets stagger
            gsap.utils.toArray('.pro-features li').forEach(function (li, i) {
                gsap.from(li, {
                    y: 30, opacity: 0, duration: .6, ease: 'power2.out',
                    delay: (i % 2) * 0.08,
                    scrollTrigger: { trigger: li, start: 'top 88%', once: true }
                });
            });

            // CTA wrapper pulse on enter
            ScrollTrigger.create({
                trigger: '.cta-wrapper',
                start: 'top 80%',
                onEnter: function () {
                    gsap.fromTo('.cta-wrapper .button',
                        { scale: 1 },
                        { scale: 1.06, duration: .35, ease: 'power2.out', yoyo: true, repeat: 1 });
                }
            });
        })();
    </script>
}
