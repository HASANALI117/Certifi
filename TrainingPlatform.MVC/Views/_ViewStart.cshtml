@{
    var isAjax = string.Equals(
        Context.Request.Headers["X-Requested-With"],
        "XMLHttpRequest",
        StringComparison.OrdinalIgnoreCase);

    if (isAjax)
    {
        Layout = null;
    }
    else if (User.Identity?.IsAuthenticated == true)
    {
        Layout = "_DashboardLayout";
    }
    else
    {
        Layout = "_Layout";
    }
}
