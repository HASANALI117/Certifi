@using TrainingPlatform.API.Models
@model IEnumerable<CertificationTrack>
@{ ViewData["Title"] = "Certification Tracks"; }

<div class="tp-page-header">
    <div>
        <h1 class="tp-page-title">Certification Tracks</h1>
        <p class="tp-page-subtitle">Define certificate templates and the courses required to earn them.</p>
    </div>
    <div class="tp-page-actions">
        <a asp-action="Create" class="tp-cta"><i class="bi bi-plus-lg"></i> New Track</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="tp-empty">
        <i class="bi bi-award"></i>
        <h4>No certification tracks yet</h4>
        <p>Create a track to start certifying trainees who complete its courses.</p>
        <a asp-action="Create" class="tp-cta"><i class="bi bi-plus-lg"></i> New Track</a>
    </div>
}
else
{
    <div class="tp-table-card">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Track</th>
                    <th style="width: 130px;">Prefix</th>
                    <th style="width: 130px;">Courses</th>
                    <th style="width: 130px;">Certificates</th>
                    <th class="text-end" style="width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>
                            <div class="d-inline-flex align-items-center gap-2">
                                <span class="tp-icon-circle"><i class="bi bi-award-fill"></i></span>
                                <div>
                                    <div class="fw-semibold">@t.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(t.Description))
                                    {
                                        <div class="tp-text-soft small">@t.Description</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(t.CertRefPrefix) ? "—" : t.CertRefPrefix)</td>
                        <td><span class="badge bg-primary">@t.CertificationTrackCourses.Count</span></td>
                        <td><span class="badge bg-secondary">@t.TraineeCertifications.Count</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline m-0"
                                  onsubmit="return confirm('Delete track @t.Name?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
