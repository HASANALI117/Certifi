@model TrainingPlatform.MVC.Models.ViewModels.CourseFormViewModel
@{ ViewData["Title"] = "Edit Course"; }

<div class="tp-page-header">
    <div>
        <h1 class="tp-page-title">Edit Course</h1>
        <p class="tp-page-subtitle">Update course details. Existing enrolments and schedules are preserved.</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <div class="tp-form-card">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle"></i><div class="flex-grow-1"></div>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="DurationHours" class="form-label"></label>
                        <input asp-for="DurationHours" class="form-control" type="number" min="1" />
                        <span asp-validation-for="DurationHours" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Capacity" class="form-label"></label>
                        <input asp-for="Capacity" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Fee" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">BD</span>
                            <input asp-for="Fee" class="form-control" type="number" step="0.001" min="0" />
                        </div>
                        <span asp-validation-for="Fee" class="text-danger"></span>
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PrerequisiteCourseId" class="form-label"></label>
                        <select asp-for="PrerequisiteCourseId" asp-items="Model.Courses" class="form-select">
                            <option value="">-- None --</option>
                        </select>
                    </div>
                </div>

                <hr class="tp-divider" />
                <h2 style="font-size: 1.05rem; margin-bottom: .25rem;">Course image</h2>
                <p class="tp-text-muted" style="font-size: .88rem; margin-bottom: 1rem;">
                    Replace the image by uploading a new file, pasting a new URL, or remove it entirely.
                </p>

                <input type="hidden" asp-for="ExistingImageUrl" />

                @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
                {
                    <div class="tp-course-image-preview mb-3">
                        <img src="@Model.ExistingImageUrl" alt="Current course image" />
                        <div class="tp-course-image-actions">
                            @* formaction overrides the outer form's action so this button posts to DeleteImage
                               directly. A nested <form> would be silently dropped by the browser. *@
                            <button type="submit"
                                    formaction="@Url.Action("DeleteImage", new { id = Model.Id })"
                                    formmethod="post"
                                    formnovalidate
                                    onclick="return confirm('Delete the current image now?');"
                                    class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete image
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <i class="bi bi-image"></i>
                        <div class="flex-grow-1">No image set. Upload a file or paste a URL below.</div>
                    </div>
                }

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ImageFile" class="form-label"></label>
                        <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" />
                        <div class="form-text">Max 5 MB. JPG, PNG, GIF, or WEBP.</div>
                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ImageUrl" class="form-label"></label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://... or /images/your-image.jpg" />
                        <div class="form-text">Used only if no file is uploaded.</div>
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>
                </div>

                <div class="tp-form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2-circle"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
