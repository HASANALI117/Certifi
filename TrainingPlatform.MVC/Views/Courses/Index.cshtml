@model CourseCatalogViewModel
@{
    ViewData["Title"] = "Course Catalog";
    var courses = Model.Courses;
    var categoryStats = Model.CategoryStats;
}

<div class="tp-courses-header">
    <div class="tp-courses-header-titles">
        <h1 class="tp-page-title">Courses</h1>
        <p class="tp-page-subtitle">Discover courses by category, prerequisite, or fee.</p>
    </div>
    <div class="dash-page-toolbar">
        <input type="text" id="courseSearch" class="dash-input" placeholder="Search courses…" />
        @if (User.IsInRole("TrainingCoordinator"))
        {
            <a asp-action="Create" class="tp-cta">
                <i class="bi bi-plus-lg"></i> New Course
            </a>
        }
    </div>
</div>

<nav class="tp-category-tabs" aria-label="Filter by category">
    <a asp-action="Index" asp-route-search="@Model.Search"
       class="tp-category-tab @(Model.SelectedCategoryId == null ? "active" : null)">
        All
        <span class="tp-tab-count">@courses.Count</span>
    </a>
    @foreach (var cat in categoryStats)
    {
        <a asp-action="Index" asp-route-categoryId="@cat.Id" asp-route-search="@Model.Search"
           class="tp-category-tab @(Model.SelectedCategoryId == cat.Id ? "active" : null)">
            @cat.Name
            <span class="tp-tab-count">@cat.CourseCount</span>
        </a>
    }
</nav>

<div class="tp-courses-layout" id="tp-courses-layout">
    <section class="tp-courses-main">
        @if (!courses.Any())
        {
            <div class="tp-empty">
                <i class="bi bi-collection"></i>
                <h4>No courses found</h4>
                <p>Try adjusting your filters or check back later for new courses.</p>
            </div>
        }
        else
        {
            <div class="tp-course-list" id="tp-course-list">
                @foreach (var course in courses)
                {
                    <article class="tp-course-row"
                             data-course-id="@course.Id"
                             data-course-title="@course.Title"
                             data-course-description="@course.Description"
                             data-course-category="@course.CategoryName"
                             data-course-hours="@course.DurationHours"
                             data-course-capacity="@course.Capacity"
                             data-course-fee="@course.Fee.ToString("C")"
                             data-course-sessions="@course.SessionCount"
                             data-course-prereq="@(course.PrerequisiteTitle ?? "")"
                             data-course-image="@(course.ImageUrl ?? "")">
                        <div class="tp-course-row-image">
                            @if (!string.IsNullOrWhiteSpace(course.ImageUrl))
                            {
                                <img src="@course.ImageUrl" alt="@course.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="tp-course-image-placeholder">
                                    <i class="bi bi-mortarboard-fill"></i>
                                </div>
                            }
                            <span class="tp-course-row-price">@course.Fee.ToString("C")</span>
                        </div>
                        <div class="tp-course-row-body">
                            <span class="tp-tag"><i class="bi bi-tag-fill"></i> @course.CategoryName</span>
                            <h3>@course.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(course.Description))
                            {
                                <p class="tp-course-row-desc">@course.Description</p>
                            }
                            <div class="tp-course-widgets">
                                <span class="tp-widget"><i class="bi bi-clock"></i> @course.DurationHours hrs</span>
                                <span class="tp-widget"><i class="bi bi-people"></i> @course.Capacity seats</span>
                                <span class="tp-widget"><i class="bi bi-folder2-open"></i> @course.CategoryName</span>
                                @if (course.PrerequisiteTitle != null)
                                {
                                    <span class="tp-widget tp-widget-warn" title="Prerequisite: @course.PrerequisiteTitle">
                                        <i class="bi bi-info-circle-fill"></i> @course.PrerequisiteTitle
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="tp-course-row-actions">
                            @if (User.IsInRole("TrainingCoordinator"))
                            {
                                <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-outline-secondary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@course.Id" method="post"
                                      onsubmit="return confirm('Delete this course?');" class="m-0">
                                    <button type="submit" class="btn btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <aside class="tp-courses-sidebar" id="tp-courses-sidebar">
        <div class="tp-sidebar-widget tp-selected-course" id="tp-selected-course">
            <div class="tp-selected-course-image">
                <img id="tp-selected-image" src="" alt="" hidden />
                <div id="tp-selected-placeholder" class="tp-course-image-placeholder">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <span class="tp-course-row-price" id="tp-selected-price"></span>
            </div>
            <div class="tp-selected-course-body">
                <span class="tp-tag"><i class="bi bi-tag-fill"></i> <span id="tp-selected-category"></span></span>
                <h3 id="tp-selected-title"></h3>
                <p class="tp-selected-description" id="tp-selected-description"></p>
                <dl class="tp-selected-list">
                    <div class="tp-selected-list-row">
                        <dt><i class="bi bi-clock"></i> Duration</dt>
                        <dd><span id="tp-selected-hours"></span> hours</dd>
                    </div>
                    <div class="tp-selected-list-row">
                        <dt><i class="bi bi-people"></i> Capacity</dt>
                        <dd><span id="tp-selected-capacity"></span> students</dd>
                    </div>
                    <div class="tp-selected-list-row">
                        <dt><i class="bi bi-cash-coin"></i> Fee</dt>
                        <dd><span id="tp-selected-fee"></span></dd>
                    </div>
                    <div class="tp-selected-list-row">
                        <dt><i class="bi bi-calendar-event"></i> Sessions</dt>
                        <dd><span id="tp-selected-sessions"></span></dd>
                    </div>
                    <div class="tp-selected-list-row tp-selected-list-row-warn" id="tp-selected-prereq-row" hidden>
                        <dt><i class="bi bi-info-circle-fill"></i> Prerequisite</dt>
                        <dd><span id="tp-selected-prereq"></span></dd>
                    </div>
                </dl>
                @if (User.IsInRole("Trainee"))
                {
                    <a id="tp-find-sessions" class="tp-cta tp-find-sessions" href="@Url.Action("Index", "CourseSessions")">
                        <i class="bi bi-calendar-event"></i> Find Sessions
                    </a>
                }
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    <script>
        (function () {
            const layout = document.getElementById('tp-courses-layout');
            const sidebar = document.getElementById('tp-courses-sidebar');
            const list = document.getElementById('tp-course-list');
            if (!layout || !sidebar) return;

            const els = {
                image: document.getElementById('tp-selected-image'),
                placeholder: document.getElementById('tp-selected-placeholder'),
                price: document.getElementById('tp-selected-price'),
                category: document.getElementById('tp-selected-category'),
                title: document.getElementById('tp-selected-title'),
                description: document.getElementById('tp-selected-description'),
                hours: document.getElementById('tp-selected-hours'),
                capacity: document.getElementById('tp-selected-capacity'),
                fee: document.getElementById('tp-selected-fee'),
                sessions: document.getElementById('tp-selected-sessions'),
                prereqRow: document.getElementById('tp-selected-prereq-row'),
                prereq: document.getElementById('tp-selected-prereq'),
                findSessions: document.getElementById('tp-find-sessions')
            };

            const findSessionsBase = '@Url.Action("Index", "CourseSessions")';

            function selectCourse(row) {
                if (!row || !list) return;

                list.querySelectorAll('.tp-course-row.is-selected').forEach(r => {
                    r.classList.remove('is-selected');
                });
                row.classList.add('is-selected');

                const d = row.dataset;

                if (d.courseImage) {
                    els.image.src = d.courseImage;
                    els.image.alt = d.courseTitle || '';
                    els.image.hidden = false;
                    els.placeholder.hidden = true;
                } else {
                    els.image.hidden = true;
                    els.image.removeAttribute('src');
                    els.placeholder.hidden = false;
                }

                els.price.textContent = d.courseFee || '';
                els.category.textContent = d.courseCategory || '';
                els.title.textContent = d.courseTitle || '';
                els.description.textContent = d.courseDescription
                    ? d.courseDescription
                    : 'No description provided.';
                els.hours.textContent = d.courseHours || '0';
                els.capacity.textContent = d.courseCapacity || '0';
                els.fee.textContent = d.courseFee || '';
                els.sessions.textContent = d.courseSessions || '0';

                if (d.coursePrereq) {
                    els.prereq.textContent = d.coursePrereq;
                    els.prereqRow.hidden = false;
                } else {
                    els.prereqRow.hidden = true;
                }

                if (els.findSessions && d.courseId) {
                    els.findSessions.href = findSessionsBase + '?courseId=' + encodeURIComponent(d.courseId);
                }
            }

            if (list) {
                list.addEventListener('click', e => {
                    // Clicks on action buttons (edit, delete, enroll) should not select the row.
                    if (e.target.closest('a, button, form')) return;
                    const row = e.target.closest('.tp-course-row');
                    if (!row) return;
                    selectCourse(row);
                });

                selectCourse(list.querySelector('.tp-course-row'));
            }

            // Live client-side search — mirrors the Reports/Trainees search:
            // filters the rendered course rows as the user types, no reload.
            const search = document.getElementById('courseSearch');
            if (search && list) {
                const rows = Array.prototype.slice.call(list.querySelectorAll('.tp-course-row'));
                search.addEventListener('input', function () {
                    const q = this.value.trim().toLowerCase();
                    let firstVisible = null;
                    rows.forEach(function (r) {
                        const d = r.dataset;
                        const hay = ((d.courseTitle || '') + ' ' +
                                     (d.courseDescription || '') + ' ' +
                                     (d.courseCategory || '')).toLowerCase();
                        const show = !q || hay.indexOf(q) !== -1;
                        r.style.display = show ? '' : 'none';
                        if (show && !firstVisible) firstVisible = r;
                    });
                    if (firstVisible) selectCourse(firstVisible);
                });
            }
        })();
    </script>
}
