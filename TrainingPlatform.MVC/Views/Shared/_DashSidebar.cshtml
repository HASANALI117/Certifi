@inject INavLinks NavLinks
@{
    var userName = User.Identity?.Name ?? string.Empty;
    var initial = !string.IsNullOrWhiteSpace(userName) ? userName.Substring(0, 1).ToUpperInvariant() : "U";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string NavActive(string ctrl) => string.Equals(ctrl, currentController, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var isCoordinator = User.IsInRole("TrainingCoordinator");
    var isInstructor = User.IsInRole("Instructor");
    var isTrainee = User.IsInRole("Trainee");
}
<aside id="dashSidebar" class="dash-sidebar">
    <a class="dash-brand" data-dash-nav-skip="true" asp-controller="Dashboard" asp-action="Index">
        <span class="dash-brand-mark">
            <img src="~/images/logo-3.png" alt="Certifi" class="dash-brand-logo" />
        </span>
        <span class="dash-brand-text">Certifi</span>
    </a>

    <nav class="dash-nav" data-dash-nav>
        @if (isCoordinator)
        {
            <div class="dash-nav-section dash-nav-section--readonly">
                <span>Reports</span>
                <span class="dash-readonly-badge">Read-only</span>
            </div>
            <a class="dash-nav-item dash-nav-item--external" data-dash-nav-skip="true" href="@NavLinks.Reports("/Dashboard")">
                <i class="bi bi-bar-chart-line"></i><span>Overview</span>
            </a>
            <a class="dash-nav-item dash-nav-item--external" data-dash-nav-skip="true" href="@NavLinks.Reports("/Reports/Enrollments")">
                <i class="bi bi-clipboard-data"></i><span>Enrollments</span>
            </a>
            <a class="dash-nav-item dash-nav-item--external" data-dash-nav-skip="true" href="@NavLinks.Reports("/Reports/Instructors")">
                <i class="bi bi-easel"></i><span>Instructors</span>
            </a>
            <a class="dash-nav-item dash-nav-item--external" data-dash-nav-skip="true" href="@NavLinks.Reports("/Reports/Sessions")">
                <i class="bi bi-calendar-week"></i><span>Sessions</span>
            </a>
            <a class="dash-nav-item dash-nav-item--external" data-dash-nav-skip="true" href="@NavLinks.Reports("/Reports/Certifications")">
                <i class="bi bi-award"></i><span>Certifications</span>
            </a>
            <a class="dash-nav-item dash-nav-item--external" data-dash-nav-skip="true" href="@NavLinks.Reports("/Reports/Revenue")">
                <i class="bi bi-cash-coin"></i><span>Revenue</span>
            </a>
            <a class="dash-nav-item dash-nav-item--external" data-dash-nav-skip="true" href="@NavLinks.Reports("/Reports/Trainees")">
                <i class="bi bi-people"></i><span>Trainees</span>
            </a>

            <div class="dash-nav-section">Manage</div>
            <a class="dash-nav-item @NavActive("Courses")" asp-controller="Courses" asp-action="Index">
                <i class="bi bi-collection"></i><span>Courses</span>
            </a>
            <a class="dash-nav-item @NavActive("CourseSessions")" asp-controller="CourseSessions" asp-action="Index">
                <i class="bi bi-calendar-event"></i><span>Sessions</span>
            </a>
            <a class="dash-nav-item @NavActive("TraineeCertifications")" asp-controller="TraineeCertifications" asp-action="Index">
                <i class="bi bi-patch-check"></i><span>Certificates</span>
            </a>
            <a class="dash-nav-item @NavActive("CertificationTracks")" asp-controller="CertificationTracks" asp-action="Index">
                <i class="bi bi-award"></i><span>Cert. Tracks</span>
            </a>
            <a class="dash-nav-item @NavActive("Enrollments")" asp-controller="Enrollments" asp-action="Manage">
                <i class="bi bi-people-fill"></i><span>Enrollments</span>
            </a>
            <a class="dash-nav-item @NavActive("Categories")" asp-controller="Categories" asp-action="Index">
                <i class="bi bi-tags"></i><span>Categories</span>
            </a>
            <a class="dash-nav-item @NavActive("Classrooms")" asp-controller="Classrooms" asp-action="Index">
                <i class="bi bi-building"></i><span>Classrooms</span>
            </a>
            <a class="dash-nav-item @NavActive("Instructors")" asp-controller="Instructors" asp-action="Index">
                <i class="bi bi-person-video3"></i><span>Instructors</span>
            </a>
            <a class="dash-nav-item @NavActive("Trainees")" asp-controller="Trainees" asp-action="Index">
                <i class="bi bi-person"></i><span>Trainees</span>
            </a>
        }
        else
        {
            <a class="dash-nav-item @NavActive("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
            </a>
            <a class="dash-nav-item @NavActive("Courses")" asp-controller="Courses" asp-action="Index">
                <i class="bi bi-collection"></i><span>Courses</span>
            </a>
            @if (!isTrainee)
            {
                <a class="dash-nav-item @NavActive("CourseSessions")" asp-controller="CourseSessions" asp-action="Index">
                    <i class="bi bi-calendar-event"></i><span>Sessions</span>
                </a>
            }
            @if (isTrainee)
            {
                <a class="dash-nav-item @NavActive("Enrollments")" asp-controller="Enrollments" asp-action="BillingAndAlerts">
                    <i class="bi bi-receipt"></i><span>My Enrollments</span>
                </a>
            }
            @if (isInstructor)
            {
                <a class="dash-nav-item @NavActive("Enrollments")" asp-controller="Enrollments" asp-action="Manage">
                    <i class="bi bi-clipboard-check"></i><span>Assessments</span>
                </a>
            }
            @if (isTrainee)
            {
                <a class="dash-nav-item @NavActive("Certification")" asp-controller="Certification" asp-action="MyCertificate">
                    <i class="bi bi-patch-check"></i><span>My Certificate</span>
                </a>
            }
        }
    </nav>

    <div class="dash-sidebar-footer">
        <div class="dropdown dropup w-100 tp-user-wrap">
            <button class="dash-user-btn position-relative" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" data-dash-nav-skip="true">
                <span class="dash-user-avatar" aria-hidden="true">@initial</span>
                <span class="dash-user-meta">
                    <span class="dash-user-name">@userName</span>
                    <span class="dash-user-role">@(isCoordinator ? "Coordinator" : isInstructor ? "Instructor" : "Trainee")</span>
                </span>
                <i class="bi bi-chevron-up dash-user-caret"></i>
                <span data-notif-badge class="badge bg-danger rounded-pill position-absolute tp-user-badge d-none">0</span>
            </button>
            <div class="dropdown-menu p-0 tp-user-menu">
                <div class="px-3 py-2 border-bottom tp-user-menu-head">
                    <div class="small text-muted">Signed in as</div>
                    <div class="fw-semibold text-truncate">@userName</div>
                </div>
                <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                    <strong class="small"><i class="bi bi-bell-fill me-1"></i>Notifications</strong>
                    <button type="button" class="tp-notif-clear-btn" data-notif-clear>Mark all read</button>
                </div>
                <div class="list-group list-group-flush tp-notif-list" data-notif-list>
                    <div class="list-group-item text-muted small text-center py-3">Loading…</div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 border-top" data-dash-nav-skip="true">
                    <button type="submit" class="dropdown-item tp-user-logout text-danger py-2 px-3">
                        <i class="bi bi-box-arrow-left me-2"></i>Log out
                    </button>
                </form>
            </div>
        </div>
    </div>
</aside>
