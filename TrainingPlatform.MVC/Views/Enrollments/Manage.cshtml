@using TrainingPlatform.API.Models
@model List<Enrollment>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-semibold mb-1">Manage Enrollments</h2>
            <p class="text-muted mb-0">Update trainee progress, transition statuses, and record course payments.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Trainee</th>
                        <th>Course</th>
                        <th>Status</th>
                        <th>Outstanding Balance</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No enrollments found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var e in Model)
                        {
                            // Safely calculate balance by checking if Payments list exists
                            var totalPaid = e.Payments?.Sum(p => p.AmountPaid) ?? 0;
                            var baseFee = e.CourseSession?.Course?.EnrollmentFee ?? 0;
                            var remainingBalance = baseFee - totalPaid;

                            // Safe string conversion for Enum rendering
                            string statusString = e.Status.ToString();

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">
                                        @(e.Trainee?.User != null ? $"{e.Trainee.User.FirstName} {e.Trainee.User.LastName}" : "Unknown Trainee")
                                    </div>
                                    <small class="text-muted">ID: @e.TraineeId</small>
                                </td>
                                <td>
                                    <span class="fw-semibold">@(e.CourseSession?.Course?.Title ?? "N/A")</span>
                                </td>
                                <td>
                                    @* Dynamic badge color depending on status *@
                                    @{
                                        var badgeClass = statusString switch
                                        {
                                            "Completed" => "bg-success",
                                            "Attending" => "bg-info text-dark",
                                            "Confirmed" => "bg-primary",
                                            "Dropped" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass px-2 py-2">
                                        @statusString
                                    </span>
                                </td>
                                <td class="fw-bold @(remainingBalance > 0 ? "text-danger" : "text-success")">
                                    @remainingBalance.ToString("C")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        @* Updated Action form to cleanly post custom fields *@
                                        <form asp-action="UpdateStatus" method="post" class="d-inline-flex gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@e.Id" />

                                            <select name="newStatus" class="form-select form-select-sm w-auto">
                                                <!option value="Enrolled" @(statusString == "Enrolled" ? "selected" : "")>Enrolled</!option>
                                                <!option value="Confirmed" @(statusString == "Confirmed" ? "selected" : "")>Confirmed</!option>
                                                <!option value="Attending" @(statusString == "Attending" ? "selected" : "")>Attending</!option>
                                                <!option value="Completed" @(statusString == "Completed" ? "selected" : "")>Completed</!option>
                                                <!option value="Dropped" @(statusString == "Dropped" ? "selected" : "")>Dropped</!option>
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-warning">
                                                Update
                                            </button>
                                        </form>

                                        <button class="btn btn-sm btn-success d-inline-flex align-items-center"
                                                data-bs-toggle="modal"
                                                data-bs-target="#payModal@e.Id">
                                            <i class="bi bi-cash-stack me-1"></i> Pay
                                        </button>
                                    </div>

                                    <div class="modal fade text-start" id="payModal@e.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow">
                                                <div class="modal-header bg-success text-white">
                                                    <h5 class="modal-title"><i class="bi bi-wallet2 me-2"></i>Record Payment</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="RecordPayment" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-body">
                                                        <input type="hidden" name="enrollmentId" value="@e.Id" />

                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Amount to Pay (Remaining: @remainingBalance.ToString("C"))</label>
                                                            <div class="input-group">
                                                                <span class="input-group-text">$</span>
                                                                <input type="number" name="amount" class="form-control" step="0.01" max="@remainingBalance" required />
                                                            </div>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Type</label>
                                                            <select name="paymentType" class="form-select">
                                                                <option value="Full">Full Payment</option>
                                                                <option value="Partial">Partial Payment</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success">Save Transaction</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>