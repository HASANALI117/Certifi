@model IEnumerable<TrainingPlatform.API.Models.Enrollment>

@{
    ViewData["Title"] = "Enrollments List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-semibold mb-1">Enrollments Directory</h2>
            <p class="text-muted mb-0">Browse, view details, update registrations, or remove records.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center">
            <i class="bi bi-person-plus-fill me-2"></i> Register New Enrollment
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Trainee</th>
                        <th>Course</th>
                        <th>Status</th>
                        <th>Enrolled On</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No enrollments found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var statusString = item.Status.ToString();

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">
                                        @(item.Trainee?.User != null ? $"{item.Trainee.User.FirstName} {item.Trainee.User.LastName}" : "Unknown Trainee")
                                    </div>
                                    <small class="text-muted d-block">Phone: @(item.Trainee?.Phone ?? "N/A")</small>
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @(item.CourseSession?.Course?.Title ?? "N/A")
                                    </div>
                                    <small class="text-muted">Session ID: @item.CourseSessionId</small>
                                </td>

                                <td>
                                    @{
                                        var badgeClass = statusString switch
                                        {
                                            "Completed" => "bg-success",
                                            "Attending" => "bg-info text-dark",
                                            "Confirmed" => "bg-primary",
                                            "Dropped" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass px-2 py-2">
                                        @statusString
                                    </span>
                                </td>

                                <td class="text-secondary small">
                                    @item.EnrolledAt.ToLocalTime().ToString("g")
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning text-dark" title="Edit">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info text-dark" title="Details">
                                            <i class="bi bi-info-circle"></i> Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>