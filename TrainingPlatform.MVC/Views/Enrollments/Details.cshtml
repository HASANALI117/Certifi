@model TrainingPlatform.API.Models.Enrollment

@{
    ViewData["Title"] = "Enrollment Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="bi bi-info-circle-fill me-2"></i>Enrollment Details
                    </h4>
                    <span class="text-white-50 small">ID: @Model.Id</span>
                </div>
                <div class="card-body p-4">

                    <div class="row mb-4">
                        <div class="col-sm-4 text-secondary fw-semibold">Trainee</div>
                        <div class="col-sm-8 text-dark mb-2">
                            <span class="fw-bold">
                                @(Model.Trainee?.User != null ? $"{Model.Trainee.User.FirstName} {Model.Trainee.User.LastName}" : "Unknown Trainee")
                            </span>
                            <small class="text-muted d-block">Trainee ID: @Model.TraineeId</small>
                            <small class="text-muted d-block">Phone: @(Model.Trainee?.Phone ?? "N/A")</small>
                        </div>

                        <div class="col-12"><hr class="my-2 text-muted" /></div>

                        <div class="col-sm-4 text-secondary fw-semibold">Course</div>
                        <div class="col-sm-8 text-dark mb-2">
                            <span class="fw-semibold">@(Model.CourseSession?.Course?.Title ?? "N/A")</span>
                            <small class="text-muted d-block">Session ID: @Model.CourseSessionId</small>
                        </div>

                        <div class="col-12"><hr class="my-2 text-muted" /></div>

                        <div class="col-sm-4 text-secondary fw-semibold">Status</div>
                        <div class="col-sm-8 mb-2">
                            @{
                                var statusString = Model.Status.ToString();
                                var badgeClass = statusString switch
                                {
                                    "Completed" => "bg-success",
                                    "Attending" => "bg-info text-dark",
                                    "Confirmed" => "bg-primary",
                                    "Dropped" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass px-2 py-1">@statusString</span>
                        </div>

                        <div class="col-12"><hr class="my-2 text-muted" /></div>

                        <div class="col-sm-4 text-secondary fw-semibold">Enrolled On</div>
                        <div class="col-sm-8 mb-2">
                            @Model.EnrolledAt.ToLocalTime().ToString("g")
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning text-dark">
                            <i class="bi bi-pencil-square me-1"></i> Edit Enrollment
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>