@model IEnumerable<TrainingPlatform.MVC.Models.ViewModels.CourseSessionListItemViewModel>
@{
    ViewData["Title"] = "Course Sessions";
    var isCoordinator = User.IsInRole("TrainingCoordinator");
    var isInstructor = User.IsInRole("Instructor");
    var isTrainee = User.IsInRole("Trainee");
    var subtitle = isCoordinator
        ? "All scheduled sessions. The system prevents instructor and classroom double-booking."
        : isInstructor
            ? "Sessions you're scheduled to teach."
            : "Browse upcoming sessions and enrol. Seat availability updates live.";
}

<div data-tp-live-page="sessions"></div>

<div class="tp-page-header">
    <div>
        <h1 class="tp-page-title">Course Sessions</h1>
        <p class="tp-page-subtitle">@subtitle</p>
    </div>
    @if (isCoordinator)
    {
        <div class="tp-page-actions">
            <a asp-action="Create" class="tp-cta">
                <i class="bi bi-plus-lg"></i> Schedule Session
            </a>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="tp-empty">
        <i class="bi bi-calendar-event"></i>
        <h4>No sessions @(isTrainee ? "available" : "scheduled")</h4>
        @if (isCoordinator)
        {
            <p>Schedule your first session to start enrolling trainees.</p>
            <a asp-action="Create" class="tp-cta"><i class="bi bi-plus-lg"></i> Schedule Session</a>
        }
        else if (isInstructor)
        {
            <p>You aren't scheduled to teach any sessions yet.</p>
        }
        else
        {
            <p>There are no upcoming sessions open for enrolment right now. Check back soon.</p>
        }
    </div>
}
else
{
    <div class="tp-table-card">
        <table class="table table-hover align-middle" data-tp-sortable-table>
            <thead>
                <tr>
                    <th class="tp-sortable" data-sort-type="text">Course</th>
                    <th class="tp-sortable" data-sort-type="text">Instructor</th>
                    <th class="tp-sortable" data-sort-type="text">Classroom</th>
                    <th class="tp-sortable" data-sort-type="number">Date</th>
                    <th class="tp-sortable" data-sort-type="number">Time</th>
                    <th class="tp-sortable" data-sort-type="number">Spots</th>
                    <th class="text-end" style="width: 240px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var spotsLeft = s.RemainingSpots;
                    var isFull = spotsLeft <= 0;
                    var (badgeClass, badgeIcon, badgeText) =
                        isFull ? ("bg-danger", "bi-x-circle-fill", "Full") :
                        spotsLeft <= 5 ? ("bg-warning text-dark", "bi-exclamation-circle-fill", spotsLeft + " left") :
                        ("bg-success", "bi-check-circle-fill", spotsLeft + " left");
                    <tr data-session-card="@s.Id">
                        <td><span class="fw-semibold">@s.CourseTitle</span></td>
                        <td class="tp-text-soft">
                            <span class="d-inline-flex align-items-center gap-1"><i class="bi bi-person"></i> @s.InstructorName</span>
                        </td>
                        <td class="tp-text-soft">
                            <span class="d-inline-flex align-items-center gap-1"><i class="bi bi-door-open"></i> @s.ClassroomName</span>
                        </td>
                        <td class="tp-text-soft tp-mono" style="font-size: .9rem;" data-sort-value="@s.SessionDate.ToString("yyyy-MM-dd")">@s.SessionDate.ToString("dd MMM yyyy")</td>
                        <td class="tp-text-soft tp-mono" style="font-size: .9rem;" data-sort-value="@s.StartTime.ToString("HH:mm")">@s.StartTime.ToString("hh\\:mm tt")</td>
                        <td data-sort-value="@spotsLeft">
                            <span id="enrollment-counter-@s.Id">
                                <span class="badge @badgeClass"><i class="bi @badgeIcon"></i> @badgeText</span>
                                <small class="text-muted d-block">(@s.EnrollmentCount/@s.Capacity)</small>
                            </span>
                            <span class="d-none" data-session-remaining="@s.Id">@spotsLeft</span>
                            <span class="d-none" data-session-enrolled="@s.Id">@s.EnrollmentCount</span>
                            <span class="d-none" data-session-capacity="@s.Id">@s.Capacity</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            @if (isTrainee)
                            {
                                if (s.IsEnrolledByCurrentUser)
                                {
                                    <span class="badge bg-info text-dark ms-1">Enrolled</span>
                                }
                                else if (s.WasDroppedByCurrentUser)
                                {
                                    <span class="badge bg-secondary ms-1" title="Dropped — enroll in another upcoming session of this course">Dropped — pick another session</span>
                                }
                                else
                                {
                                    <form asp-controller="Enrollments" asp-action="Enroll" method="post" class="d-inline m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="courseSessionId" value="@s.Id" />
                                        <button id="enroll-btn-@s.Id" type="submit" class="btn btn-sm @(isFull ? "btn-secondary" : "btn-primary")" disabled="@isFull">
                                            @(isFull ? "Session Full" : "Enroll Now")
                                        </button>
                                    </form>
                                }
                            }
                            @if (isCoordinator)
                            {
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary ms-1" title="Edit session">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline m-0"
                                      onsubmit="return confirm('Delete this session?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        (function () {
            function cellSortValue(row, index) {
                var cell = row.cells[index];
                if (!cell) return '';
                if (cell.dataset && cell.dataset.sortValue != null && cell.dataset.sortValue !== '') {
                    return cell.dataset.sortValue;
                }
                return (cell.textContent || '').trim();
            }

            function sortBy(table, header, columnIndex) {
                var currentDir = header.getAttribute('aria-sort');
                var nextDir = currentDir === 'ascending' ? 'descending' : 'ascending';

                table.querySelectorAll('thead th.tp-sortable').forEach(function (th) {
                    th.removeAttribute('aria-sort');
                });
                header.setAttribute('aria-sort', nextDir);

                var type = header.getAttribute('data-sort-type') || 'text';
                var tbody = table.tBodies[0];
                if (!tbody) return;
                var rows = Array.prototype.slice.call(tbody.rows);

                rows.sort(function (a, b) {
                    var av = cellSortValue(a, columnIndex);
                    var bv = cellSortValue(b, columnIndex);
                    if (type === 'number') {
                        var an = Number(av);
                        var bn = Number(bv);
                        if (!isNaN(an) && !isNaN(bn)) {
                            return nextDir === 'ascending' ? an - bn : bn - an;
                        }
                    }
                    var cmp = av.localeCompare(bv, undefined, { numeric: true, sensitivity: 'base' });
                    return nextDir === 'ascending' ? cmp : -cmp;
                });

                var frag = document.createDocumentFragment();
                rows.forEach(function (r) { frag.appendChild(r); });
                tbody.appendChild(frag);
            }

            function initSortableTables(root) {
                (root || document).querySelectorAll('table[data-tp-sortable-table]').forEach(function (table) {
                    if (table.dataset.tpSortBound === '1') return;
                    table.dataset.tpSortBound = '1';
                    table.querySelectorAll('thead th.tp-sortable').forEach(function (th, index) {
                        th.setAttribute('role', 'button');
                        th.setAttribute('tabindex', '0');
                        th.addEventListener('click', function () { sortBy(table, th, index); });
                        th.addEventListener('keydown', function (e) {
                            if (e.key === 'Enter' || e.key === ' ') {
                                e.preventDefault();
                                sortBy(table, th, index);
                            }
                        });
                    });
                });
            }

            initSortableTables(document);
        })();
    </script>
}
